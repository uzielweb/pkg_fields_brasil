<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="fields" method="upgrade">
    <name>PLG_FIELDS_CPFCNPJ</name>
    <author>Uziel Almeida Oliveira</author>
    <creationDate>2026-09</creationDate>
    <copyright>(C) 2026 Uziel Almeida Oliveira. Todos os direitos reservados.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE</license>
    <authorEmail>uzielweb@gmail.com</authorEmail>
    <authorUrl>https://github.com/uzielweb</authorUrl>
    <version>1.0.0-alpha2</version>
    <description>PLG_FIELDS_CPFCNPJ_XML_DESCRIPTION</description>
    <namespace path="src">Uziel\Plugin\Fields\Cpfcnpj</namespace>
    <scriptfile>script.php</scriptfile>
    <files>
        <folder>params</folder>
        <folder>rules</folder>
        <folder plugin="cpfcnpj">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
        <filename>script.php</filename>
    </files>
    <media destination="plg_fields_cpfcnpj" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>js</folder>
    </media>
    <languages>
        <language tag="pt-BR">language/pt-BR/plg_fields_cpfcnpj.ini</language>
        <language tag="pt-BR">language/pt-BR/plg_fields_cpfcnpj.sys.ini</language>
        <language tag="en-GB">language/en-GB/plg_fields_cpfcnpj.ini</language>
        <language tag="en-GB">language/en-GB/plg_fields_cpfcnpj.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="apply_mask"
                    type="radio"
                    label="PLG_FIELDS_CPFCNPJ_PARAMS_APPLY_MASK_LABEL"
                    description="PLG_FIELDS_CPFCNPJ_PARAMS_APPLY_MASK_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="display_format"
                    type="list"
                    label="PLG_FIELDS_CPFCNPJ_PARAMS_DISPLAY_FORMAT_LABEL"
                    description="PLG_FIELDS_CPFCNPJ_PARAMS_DISPLAY_FORMAT_DESC"
                    default="formatted"
                >
                    <option value="formatted">PLG_FIELDS_CPFCNPJ_PARAMS_DISPLAY_FORMAT_FORMATTED</option>
                    <option value="unformatted">PLG_FIELDS_CPFCNPJ_PARAMS_DISPLAY_FORMAT_UNFORMATTED</option>
                    <option value="lgpd">PLG_FIELDS_CPFCNPJ_PARAMS_DISPLAY_FORMAT_LGPD</option>
                </field>
            </fieldset>
        </fields>
    </config>
    <updateservers>
        <server type="extension" priority="1" name="PLG_FIELDS_CPFCNPJ">https://raw.githubusercontent.com/uzielweb/pkg_fields_brasil/main/updates.xml</server>
    </updateservers>
</extension>
