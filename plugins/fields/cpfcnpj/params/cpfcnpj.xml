<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="fieldparams">
        <fieldset name="fieldparams">
            <field
                name="apply_mask"
                type="radio"
                label="PLG_FIELDS_CPFCNPJ_PARAMS_APPLY_MASK_LABEL"
                description="PLG_FIELDS_CPFCNPJ_PARAMS_APPLY_MASK_DESC"
                layout="joomla.form.field.radio.switcher"
                default="1"
                filter="integer"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

            <field
                name="display_format"
                type="list"
                label="PLG_FIELDS_CPFCNPJ_PARAMS_DISPLAY_FORMAT_LABEL"
                description="PLG_FIELDS_CPFCNPJ_PARAMS_DISPLAY_FORMAT_DESC"
                default="formatted"
            >
                <option value="formatted">PLG_FIELDS_CPFCNPJ_PARAMS_DISPLAY_FORMAT_FORMATTED</option>
                <option value="unformatted">PLG_FIELDS_CPFCNPJ_PARAMS_DISPLAY_FORMAT_UNFORMATTED</option>
                <option value="lgpd">PLG_FIELDS_CPFCNPJ_PARAMS_DISPLAY_FORMAT_LGPD</option>
            </field>
        </fieldset>
    </fields>
</form>
