<?xml version="1.0" encoding="UTF-8"?>
<form>
    <field
        name="pix_key"
        type="text"
        label="PLG_FIELDS_PIX_SUB_KEY_LABEL"
        description="PLG_FIELDS_PIX_SUB_KEY_DESC"
        hint="PLG_FIELDS_PIX_SUB_KEY_HINT"
        required="true"
        validate="pix"
        class="validate-pix joomla-field-pix"
    />

    <field
        name="merchant_name"
        type="text"
        label="PLG_FIELDS_PIX_SUB_NAME_LABEL"
        description="PLG_FIELDS_PIX_SUB_NAME_DESC"
        maxlength="25"
    />

    <field
        name="merchant_city"
        type="text"
        label="PLG_FIELDS_PIX_SUB_CITY_LABEL"
        description="PLG_FIELDS_PIX_SUB_CITY_DESC"
        maxlength="15"
    />

    <field
        name="amount_mode"
        type="list"
        label="PLG_FIELDS_PIX_SUB_AMOUNT_MODE_LABEL"
        description="PLG_FIELDS_PIX_SUB_AMOUNT_MODE_DESC"
        default="none"
    >
        <option value="none">PLG_FIELDS_PIX_PARAMS_AMOUNT_MODE_NONE</option>
        <option value="fixed">PLG_FIELDS_PIX_PARAMS_AMOUNT_MODE_FIXED</option>
        <option value="free">PLG_FIELDS_PIX_PARAMS_AMOUNT_MODE_FREE</option>
    </field>

    <field
        name="amount"
        type="number"
        label="PLG_FIELDS_PIX_SUB_AMOUNT_LABEL"
        description="PLG_FIELDS_PIX_SUB_AMOUNT_DESC"
        step="0.01"
        min="0"
    />

    <field
        name="txid"
        type="text"
        label="PLG_FIELDS_PIX_SUB_TXID_LABEL"
        description="PLG_FIELDS_PIX_SUB_TXID_DESC"
        default="***"
        maxlength="25"
    />

    <field
        name="description"
        type="text"
        label="PLG_FIELDS_PIX_SUB_DESC_LABEL"
        description="PLG_FIELDS_PIX_SUB_DESC_DESC"
        maxlength="50"
    />

    <field
        name="qrcode_logo_type"
        type="list"
        label="PLG_FIELDS_PIX_SUB_QRCODE_LOGO_TYPE_LABEL"
        description="PLG_FIELDS_PIX_SUB_QRCODE_LOGO_TYPE_DESC"
        default="inherit"
    >
        <option value="inherit">PLG_FIELDS_PIX_LOGO_TYPE_INHERIT</option>
        <option value="none">PLG_FIELDS_PIX_LOGO_TYPE_NONE</option>
        <option value="pix">PLG_FIELDS_PIX_LOGO_TYPE_PIX</option>
        <option value="custom">PLG_FIELDS_PIX_LOGO_TYPE_CUSTOM</option>
    </field>

    <field
        name="qrcode_logo"
        type="media"
        label="PLG_FIELDS_PIX_SUB_QRCODE_LOGO_LABEL"
        description="PLG_FIELDS_PIX_SUB_QRCODE_LOGO_DESC"
        showon="qrcode_logo_type:custom"
    />
</form>
