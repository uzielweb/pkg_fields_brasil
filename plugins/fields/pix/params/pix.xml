<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="fieldparams">
        <fieldset name="fieldparams">
            <field
                name="repeat"
                type="radio"
                label="PLG_FIELDS_PIX_PARAMS_REPEAT_LABEL"
                description="PLG_FIELDS_PIX_PARAMS_REPEAT_DESC"
                layout="joomla.form.field.radio.switcher"
                default="0"
                filter="integer"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

            <field
                name="merchant_name"
                type="text"
                label="PLG_FIELDS_PIX_PARAMS_MERCHANT_NAME_LABEL"
                description="PLG_FIELDS_PIX_PARAMS_MERCHANT_NAME_DESC"
                default="BENEFICIARIO"
                maxlength="25"
            />

            <field
                name="merchant_city"
                type="text"
                label="PLG_FIELDS_PIX_PARAMS_MERCHANT_CITY_LABEL"
                description="PLG_FIELDS_PIX_PARAMS_MERCHANT_CITY_DESC"
                default="SAO PAULO"
                maxlength="15"
            />

            <field
                name="amount_mode"
                type="list"
                label="PLG_FIELDS_PIX_PARAMS_AMOUNT_MODE_LABEL"
                description="PLG_FIELDS_PIX_PARAMS_AMOUNT_MODE_DESC"
                default="none"
            >
                <option value="none">PLG_FIELDS_PIX_PARAMS_AMOUNT_MODE_NONE</option>
                <option value="fixed">PLG_FIELDS_PIX_PARAMS_AMOUNT_MODE_FIXED</option>
                <option value="free">PLG_FIELDS_PIX_PARAMS_AMOUNT_MODE_FREE</option>
            </field>

            <field
                name="default_amount"
                type="number"
                label="PLG_FIELDS_PIX_PARAMS_DEFAULT_AMOUNT_LABEL"
                description="PLG_FIELDS_PIX_PARAMS_DEFAULT_AMOUNT_DESC"
                default="0.00"
                step="0.01"
                min="0"
            />

            <field
                name="txid"
                type="text"
                label="PLG_FIELDS_PIX_PARAMS_TXID_LABEL"
                description="PLG_FIELDS_PIX_PARAMS_TXID_DESC"
                default="***"
                maxlength="25"
            />

            <field
                name="show_qrcode"
                type="radio"
                label="PLG_FIELDS_PIX_PARAMS_SHOW_QRCODE_LABEL"
                description="PLG_FIELDS_PIX_PARAMS_SHOW_QRCODE_DESC"
                layout="joomla.form.field.radio.switcher"
                default="1"
                filter="integer"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

            <field
                name="qrcode_logo_type"
                type="list"
                label="PLG_FIELDS_PIX_PARAMS_QRCODE_LOGO_TYPE_LABEL"
                description="PLG_FIELDS_PIX_PARAMS_QRCODE_LOGO_TYPE_DESC"
                default="pix"
                showon="show_qrcode:1"
            >
                <option value="none">PLG_FIELDS_PIX_LOGO_TYPE_NONE</option>
                <option value="pix">PLG_FIELDS_PIX_LOGO_TYPE_PIX</option>
                <option value="custom">PLG_FIELDS_PIX_LOGO_TYPE_CUSTOM</option>
            </field>

            <field
                name="qrcode_logo"
                type="media"
                label="PLG_FIELDS_PIX_PARAMS_QRCODE_LOGO_LABEL"
                description="PLG_FIELDS_PIX_PARAMS_QRCODE_LOGO_DESC"
                showon="show_qrcode:1[AND]qrcode_logo_type:custom"
            />

            <field
                name="show_copy_button"
                type="radio"
                label="PLG_FIELDS_PIX_PARAMS_SHOW_COPY_BUTTON_LABEL"
                description="PLG_FIELDS_PIX_PARAMS_SHOW_COPY_BUTTON_DESC"
                layout="joomla.form.field.radio.switcher"
                default="1"
                filter="integer"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>
        </fieldset>
    </fields>
</form>
